    <string name="delay_label">收到通知后等多少毫秒再清除</string>
    <string name="delay_hint">10000</string>

    <string name="title_label">标题必须包含（留空 = 不限制）</string>
    <string name="title_hint">选填</string>
    <string name="text_label">正文必须包含（留空 = 不限制）</string>
    <string name="text_hint">选填</string>
    <string name="keyword_explain">两个都填 = 必须同时满足；只填一个 = 只查那一个。多数应用的通知标题是应用名，内容在正文里，所以关键字一般填在正文框。</string>

    <string name="save">保存</string>
    <string name="save_done">已保存</string>

    <string name="keepalive_title">后台常驻</string>
    <string name="fgs_checking">常驻服务：检查中…</string>
    <string name="fgs_running">常驻服务：运行中 ✓</string>
    <string name="fgs_stopped">常驻服务：没在跑 ✗ —— 这就是它会失效的原因</string>

    <string name="overlay_grant">② 开启「悬浮窗」权限</string>
    <string name="overlay_granted">悬浮窗权限：已开启 ✓</string>
    <string name="overlay_hint">国产系统对「有悬浮窗权限」的应用可能更宽容。应用不会真的弹任何窗口，只挂一个 1×1 的透明点。</string>

    <string name="admin_grant">① 激活「设备管理器」（最关键）</string>
    <string name="admin_granted">设备管理器：已激活 ✓</string>
    <string name="admin_hint">成为设备管理器的应用，系统会当成「特权应用」对待，后台清理时明显更宽容，而且卸载必须先手动取消激活。\n\n本应用刻意没有申请任何设备管理能力 —— 不能锁屏、不能清数据、不能改密码，只借这个「身份」。</string>
    <string name="keepalive_hint">保住它靠两件事：一条前台服务，加上「被划掉之后 1 秒内自动重启」。MacroDroid 靠的也是同一招 —— 它的日志里写着 task removed - attempting to restart mechanism。\n\n通知栏会挂一条静默通知：有状态栏小图标，但不响、不震、不亮屏、不弹横幅。图标可以点下面隐藏掉，但实测藏掉之后更容易被系统杀。</string>
    <string name="keepalive_hide_notif">隐藏这条常驻通知（可能导致被杀）</string>
    <string name="keepalive_hide_warn">提醒：把渠道彻底关掉之后，系统很可能因此把本应用杀掉 —— MacroDroid 的文档也是这么说的。真遇到又开始失效，回这里重新打开就行。</string>
    <string name="keepalive_battery">把本应用设为「不限制后台」</string>
    <string name="keepalive_battery_urgent">① 先点这里：设为「不限制后台」（很重要）</string>
    <string name="keepalive_battery_ok">已在白名单里 ✓</string>
    <string name="keepalive_autostart">打开系统的「自启动管理」</string>
    <string name="keepalive_autostart_fail">没能直接打开自启动页（已帮你打开本应用的详情页）。请到「i管家 → 应用管理 → 权限管理 → 自启动」，或「设置 → 应用与权限 → 权限管理 → 自启动」里，把「通知清理器」打开。</string>

    <string name="battery_manual_title">系统没接受这个请求</string>
    <string name="battery_manual_msg">vivo / OriginOS 的「智能控制」是厂商自己的一套后台管理，和安卓标准的电池优化白名单不是同一个东西，所以那个系统对话框在 vivo 上经常点了也没用。\n\n请手动设置（两种路径任选）：\n\n① 设置 → 电池 → 后台耗电管理 → 找到「通知清理器」→ 选「允许后台高耗电」\n\n② 设置 → 应用与权限 → 应用管理 → 通知清理器 → 耗电管理 → 允许后台高耗电</string>
    <string name="open_app_details">打开应用详情页</string>

    <string name="channel_keepalive">后台常驻</string>
    <string name="channel_keepalive_desc">让应用在划掉多任务后仍然活着的常驻通知。已静音，但需要保留状态栏图标 —— 藏掉图标会被系统当成没有前台服务而杀掉。</string>
    <string name="notif_title">通知清理器在后台运行</string>
    <string name="notif_text">点开可以调整规则</string>

    <string name="selftest_title">自检</string>
    <string name="selftest_hint">点一下，本应用自己发一条通知，然后看它会不会按上面的延迟时间自动消失。这是唯一能证明「整条链路通不通」的办法。</string>
    <string name="selftest_btn">发一条测试通知</string>
    <string name="selftest_idle">还没测过</string>

