<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部标题区：固定住，不跟着滚动，状态永远看得见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/header_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/headerChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_bad"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/chip_checking"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <!-- 权限 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/perm_title" />

                    <TextView
                        android:id="@+id/permState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_checking"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/permHint"
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/perm_hint_unknown" />

                <TextView
                    android:id="@+id/openAccess"
                    style="@style/BtnSoft"
                    android:layout_marginTop="12dp"
                    android:text="@string/open_access" />

                <TextView
                    android:id="@+id/reconnect"
                    style="@style/BtnGhost"
                    android:layout_marginTop="8dp"
                    android:text="@string/reconnect"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/deepFixBtn"
                    style="@style/BtnGhost"
                    android:layout_marginTop="8dp"
                    android:text="@string/deep_fix" />

                <TextView
                    android:id="@+id/deepFixHint"
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:text="@string/deep_fix_hint" />
            </LinearLayout>

            <!-- 保活 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/keepalive_title" />

                <TextView
                    android:id="@+id/fgsState"
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/fgs_checking" />

                <!-- 无障碍：目前最有希望的一项，所以放在最上面 -->
                <TextView
                    android:id="@+id/a11yBtn"
                    style="@style/BtnPrimary"
                    android:layout_marginTop="10dp"
                    android:text="@string/a11y_grant" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/a11y_hint" />

                <TextView
                    android:id="@+id/adminBtn"
                    style="@style/BtnPrimary"
                    android:layout_marginTop="10dp"
                    android:text="@string/admin_grant" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/admin_hint" />

                <TextView
                    android:id="@+id/overlayBtn"
                    style="@style/BtnGhost"
                    android:layout_marginTop="10dp"
                    android:text="@string/overlay_grant" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/overlay_hint" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/keepalive_hint" />

                <TextView
                    android:id="@+id/hideNotifBtn"
                    style="@style/BtnSoft"
                    android:layout_marginTop="12dp"
                    android:text="@string/keepalive_hide_notif" />

                <TextView
                    android:id="@+id/hideNotifWarn"
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:text="@string/keepalive_hide_warn" />

                <TextView
                    android:id="@+id/batteryBtn"
                    style="@style/BtnGhost"
                    android:layout_marginTop="8dp"
                    android:text="@string/keepalive_battery" />

                <TextView
                    android:id="@+id/autostartBtn"
                    style="@style/BtnGhost"
                    android:layout_marginTop="8dp"
                    android:text="@string/keepalive_autostart" />

                <TextView
                    android:id="@+id/keepAliveHint"
                    style="@style/Label"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 规则 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/rule_title" />

                <Switch
                    android:id="@+id/enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:text="@string/enabled"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="10dp"
                    android:text="@string/packages_label" />

                <EditText
                    android:id="@+id/packages"
                    style="@style/Input"
                    android:layout_marginTop="6dp"
                    android:hint="@string/packages_hint"
                    android:inputType="text" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="12dp"
                    android:text="@string/delay_label" />

                <EditText
                    android:id="@+id/delay"
                    style="@style/Input"
                    android:layout_marginTop="6dp"
                    android:hint="@string/delay_hint"
                    android:inputType="number" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="12dp"
                    android:text="@string/title_label" />

                <EditText
                    android:id="@+id/titleKeyword"
                    style="@style/Input"
                    android:layout_marginTop="6dp"
                    android:hint="@string/title_hint"
                    android:inputType="text" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="12dp"
                    android:text="@string/text_label" />

                <EditText
                    android:id="@+id/textKeyword"
                    style="@style/Input"
                    android:layout_marginTop="6dp"
                    android:hint="@string/text_hint"
                    android:inputType="text" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/keyword_explain" />

                <TextView
                    android:id="@+id/save"
                    style="@style/BtnPrimary"
                    android:layout_marginTop="16dp"
                    android:text="@string/save" />
            </LinearLayout>

            <!-- 自检 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/selftest_title" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="6dp"
                    android:text="@string/selftest_hint" />

                <TextView
                    android:id="@+id/testBtn"
                    style="@style/BtnGhost"
                    android:layout_marginTop="12dp"
                    android:text="@string/selftest_btn" />

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/selftest_idle"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 日志 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/log_title" />

                    <TextView
                        android:id="@+id/viewLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/log_view_all"
                        android:textColor="@color/primary_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_log"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="90dp"
                    android:padding="12dp"
                    android:text="@string/log_empty"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 当前通知 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/active_title" />

                    <TextView
                        android:id="@+id/activeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="—"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/refreshActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/active_refresh"
                        android:textColor="@color/primary_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/clearActive"
                    style="@style/BtnGhost"
                    android:layout_marginTop="10dp"
                    android:text="@string/active_clear" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:text="@string/tip" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
