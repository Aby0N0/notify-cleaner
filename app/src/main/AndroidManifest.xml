<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 巡检期间让 CPU 别睡，保证到点能清 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 自检要自己发一条通知，Android 13 起需要这个 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后重新排看门狗闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 申请电池优化白名单（防被杀的第二道保险） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 前台服务：这是"划掉多任务还活着"的关键，MacroDroid 靠的也是这个 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 被划掉后 1 秒内精确把自己拉回来；拿不到这个权限就退回普通闹钟，会晚几秒 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 深度修复用：把本应用从「通知使用权」列表里摘掉再写回，逼系统重新注册监听。
        这是签名级权限，普通应用拿不到，必须用电脑执行一次：
            adb shell pm grant com.dsh.notifycleaner android.permission.WRITE_SECURE_SETTINGS
        没授予时应用照常工作，只是这个修复按钮用不了。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 监听网络变化广播（MacroDroid 的 crashguard 库也这么干） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        「显示在其他应用上层」—— 保活的关键一环。
        这条是从 MacroDroid 的权限清单里发现的：国产 ROM 对"有悬浮窗权限"的应用
        明显更宽容，不容易被杀。只需要用户在设置里点一下，不需要 adb。
        应用不会真的弹任何窗口，只挂一个 1×1 的透明点。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            本体：监听通知栏。
            它由系统绑定，但光靠它不够 —— 进程被 ROM 杀掉后就断了。
        -->
        <service
            android:name=".NotifyCleanerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            保命：前台服务。
            stopWithTask=false 让它在"划掉多任务"时不被一起干掉；
            START_STICKY 让它被系统杀掉后能自动重启。
            这条前台服务的通知渠道是 IMPORTANCE_MIN，几乎看不见，也可以在系统设置里关掉。
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the notification listener bound so notifications from watched apps can be auto-dismissed after a delay." />
        </service>

        <!--
            看门狗。由系统闹钟叫醒，进程死了也能被拉起来。
            同时接管开机广播和应用更新广播 —— 这两种情况下系统会清掉已排的闹钟。
        -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            靠系统广播把自己叫醒。抄的是 MacroDroid 里 crashguard 库的 PowerReceiver /
            NetworkReceiver：这类广播由系统发出，**不需要「自启动」权限**，
            每插一次充电器、切一次网络，就多一次把自己救回来的机会。
        -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!--
            JobScheduler 任务。抄的是 MacroDroid 里的 crashguard.SystemJobService。
            任务由系统托管，进程被杀也还在，而且**不需要「自启动」权限**。
        -->
        <service
            android:name=".RestartJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
